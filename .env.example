# ==============================================================
# FICHIER : .env.example
# RÔLE   : Modèle des variables d'environnement à dupliquer en .env
# USAGE  : Copier ce fichier en .env et remplir les valeurs réelles.
#          Ne JAMAIS committer le vrai .env sur GitHub !
# ==============================================================

# --- Base de données MongoDB (Atlas gratuit) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
DB_NAME=rfidlib

# --- Redis Upstash (sessions du double scan) ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# --- Sécurité ---
JWT_SECRET=change-moi-en-production-avec-une-longue-chaine
API_KEY=cle-partagee-entre-esp32-et-backend

# --- Frontend (Vite) ---
VITE_API_URL=
